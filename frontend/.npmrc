# BR-18 (`npm-sin-scripts-de-instalacion`) — el ataque a keyv del 2026-08-04 se ejecutaba
# desde un hook `preinstall`, antes de que nadie importara nada: bastaba con instalar.
# Aqui los scripts de ciclo de vida quedan apagados, y esta comprobado que los dos
# proyectos compilan sin ellos. Si algun dia una dependencia los necesita de verdad, se
# corre `npm rebuild <paquete>` a mano — nombrando cual, que es justo la decision que
# esta linea obliga a tomar en voz alta.
ignore-scripts=true

# El lockfile manda. `npm install` resuelve versiones nuevas sin pedir permiso; `npm ci`
# instala exactamente lo escrito y falla si no cuadra.
save-exact=false
